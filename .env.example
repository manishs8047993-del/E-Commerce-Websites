# ============================================
# E-Commerce App Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# For Vercel: Add these SAME variables in
#   Vercel Dashboard → Project → Settings → Environment Variables
# ============================================

PORT=5055
NODE_ENV=development

# ---- MySQL Database Configuration ----
# LOCAL: Use localhost / 127.0.0.1
# VERCEL (Cloud DB): Use your cloud MySQL host (e.g. Aiven, PlanetScale, Railway)
#   If you leave DB_HOST as 127.0.0.1 on Vercel, the app will use
#   an in-memory store (data resets on each request).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ecommerce_db

# ---- JWT Authentication ----
JWT_SECRET=super_secret_jwt_key_ecommerce_major_project_2026
JWT_EXPIRES_IN=7d

# ============================================
# DEMO LOGIN CREDENTIALS (auto-seeded)
# ============================================
# Admin:           admin@ecommerce.com       / admin123
# Delivery Agent:  david.delivery@ecommerce.com / deliverypass123
# Customer:        john@example.com          / customer123
# ============================================
